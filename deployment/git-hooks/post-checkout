#!/usr/bin/env bash
#
# post-checkout: re-sync the local web container to the checked-out Git branch.
#
# COPO loads its UI schemas into MongoDB and its profile types / components into
# Postgres *once*, then serves them from the database. Switching to a branch
# whose definitions differ (e.g. main <-> edp) leaves the database describing
# the OLD branch, which shows up as import errors / profiles that won't render.
# Likewise, branches may pin different Python packages than the ones installed
# in the container.
#
# This hook detects when the schema, profile type and Django group definitions
# or the Python requirements differ between the branch that the developer left
# and the one that the developer switches to. It then, re-runs the matching
# setup inside the running web container so that the database and installed
# packages match the project code for the switched branch.
#
# It only runs on a real branch switch, and only when the relevant files
# actually changed — ordinary branch hops stay fast. Skip explicitly with:
#   COPO_SKIP_SETUP=1 git checkout <branch>
#
# Install (once per clone): point git at this tracked hooks directory:
#   git config core.hooksPath deployment/git-hooks

prev_head="$1"
new_head="$2"
branch_flag="$3"   # 1 = branch checkout, 0 = file checkout

# Only act on branch switches, not `git checkout -- <file>`.
[ "$branch_flag" = "1" ] || exit 0
# No-op when HEAD didn't actually move (e.g. checkout of the current branch).
[ "$prev_head" = "$new_head" ] && exit 0
# Allow an explicit opt-out.
[ -n "$COPO_SKIP_SETUP" ] && exit 0

# Paths whose changes mean the database needs updating.
# They relate to tables (i.e. migrations) or the 
# definitions that seed into them.
watch_paths=(
  "src/apps/*/migrations/*"
  "common/schemas"
  "src/apps/*/management/commands/setup_schemas.py"
  "src/apps/*/management/commands/setup_profile_types.py"
  "src/apps/*/management/commands/setup_groups.py"
)

# Paths whose changes mean the Python packages need (re)installing.
requirements_paths=("requirements")

# Run the `manage.py` commands in order to keep the database in sync with the code.
# Run the migrations first to create the required tables then, `setup_schemas`
# which loads the data that profile types and components depend on.
setup_commands=(
  "migrate --noinput"
  "setup_schemas"
  "setup_profile_types"
  "setup_groups"
)

# Did any of the given paths listed in the 'watch_paths' list change between 
# commits or switched branches? If git can't compare (shallow clone, etc.), we err on 
# the side of running the setup commands.
changed() {
  ! git diff --quiet "$prev_head" "$new_head" -- "$@" 2>/dev/null
}

setup_changed=0
requirements_changed=0
changed "${watch_paths[@]}" && setup_changed=1
changed "${requirements_paths[@]}" && requirements_changed=1
[ "$setup_changed" = "0" ] && [ "$requirements_changed" = "0" ] && exit 0

# Find the running web container (override with COPO_WEB_CONTAINER).
container="${COPO_WEB_CONTAINER:-$(docker ps --format '{{.Names}}' 2>/dev/null | grep -E 'copo_web|copo-web' | head -1)}"

if [ -z "$container" ]; then
  echo "[copo] This branch changed setup definitions or Python requirements but, there's no running web"
  echo "[copo] container was found. Once the stack is up, run:"
  if [ "$requirements_changed" = "1" ]; then
    echo "[copo]   docker exec -w /copo <web-container> pip install --use-deprecated=legacy-resolver -r requirements/dev.txt"
  fi
  if [ "$setup_changed" = "1" ]; then
    for command in "${setup_commands[@]}"; do
      echo "[copo]   docker exec -w /copo <web-container> python manage.py $command"
    done
  fi
  exit 0
fi

# Install Python requirements so that the setup commands 
# below run against the correct packages.
if [ "$requirements_changed" = "1" ]; then
  echo "[copo] Requirements changed — installing them in '$container'..."
  docker exec -w /copo "$container" pip install -q --use-deprecated=legacy-resolver -r requirements/dev.txt \
    && echo "[copo] Requirements installed for $(git rev-parse --abbrev-ref HEAD)." \
    || echo "[copo] Install failed — run 'pip install -r requirements/dev.txt' in the container manually."
fi

if [ "$setup_changed" = "1" ]; then
  echo "[copo] Branch definitions changed - updating the database in '$container'..."
  for command in "${setup_commands[@]}"; do
    echo "[copo]   python manage.py $command"
    # `$command` is unquoted so that the 'migrate --noinput' latter
    # part of the command splits into the command and its option correctly.
    if ! docker exec -w /copo "$container" python manage.py $command; then
      echo "[copo] '$command' failed — run the remaining commands manually:"
      echo "[copo]   ${setup_commands[*]}"
      exit 0
    fi
  done
  echo "[copo] Database re-synced to $(git rev-parse --abbrev-ref HEAD)."
fi

exit 0
