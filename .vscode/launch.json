{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Python: Django",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Setup All",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["setup_all"],
      "console": "integratedTerminal",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Clear Profiles (dry run)",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["clear_profiles"],
      "console": "integratedTerminal",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Clear Profiles (COMMIT — deletes!)",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["clear_profiles", "--include-orphans", "--commit", "--yes"],
      "console": "integratedTerminal",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Django Shell",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["shell_plus", "--ptpython"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Django makemigration",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["makemigration"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Celery Workers",
      "type": "debugpy",
      "python": "/opt/venv/bin/python",
      "env": {
        "GEVENT_SUPPORT": "True"
      },
      "request": "launch",
      "module": "celery",
      "console": "integratedTerminal",
      "args": [
        "-A",
        "src",
        "worker",
        "-l",
        "debug",
        "-P",
        "gevent",
        "--concurrency",
        "10",
        "-Q",
        "celery",
        "-E",
        "--hostname=celery@%h"
      ],
      "justMyCode": true
    },
    {
      "name": "Python: Celery Workers file_transfers",
      "type": "debugpy",
      "python": "/opt/venv/bin/python",
      "env": {
        "GEVENT_SUPPORT": "True"
      },
      "request": "launch",
      "module": "celery",
      "console": "integratedTerminal",
      "args": [
        "-A",
        "src",
        "worker",
        "-l",
        "debug",
        "-P",
        "gevent",
        "--concurrency",
        "10",
        "-Q",
        "file_transfers",
        "-E",
        "--hostname=file_transfers@%h"
      ],
      "justMyCode": true
    },
    {
      "name": "Python: Celery Beat",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "module": "celery",
      "console": "integratedTerminal",
      "env": {
        "GEVENT_SUPPORT": "True"
      },
      "args": ["-A", "src", "beat", "-l", "critical"]
    },
    {
      "name": "Python: Build manifest field layout/schema",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["build_manifest_field_layout"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Generate standards map",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["generate_standards_map"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Validate API enums",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/manage.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "args": ["validate_api_enums"],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Handle Update Requests",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/venv/bin/python",
      "program": "${workspaceFolder}/shared_tools/scripts/copo_record/update_requests/handle_update_requests.py",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/lib:${PYTHONPATH}"
      },
      "cwd": "${workspaceFolder}/shared_tools/scripts/copo_record/update_requests",
      "args": [],
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Playwright: Attach debugger",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/copo"
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "Start all",
      "configurations": [
        "Python: Django",
        "Python: Celery Workers",
        "Python: Celery Workers file_transfers",
        "Python: Celery Beat",
      ],
      "stopAll": true
    },
    {
      "name": "Playwright: Debug tests",
      "configurations": [
        "Playwright: Attach debugger"
      ],
      "preLaunchTask": "Playwright: Start Playwright tests script in debug mode",
      "stopAll": true
    }
  ]
}
